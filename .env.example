# Copy to .env and fill in. Never commit .env.
# Railway → Postgres → Variables → DATABASE_PUBLIC_URL (load_data.py only, write access)
DATABASE_ADMIN_URL=
# The app's database (locally: same public URL; on Railway: ${{Postgres.DATABASE_URL}})
DATABASE_URL=
# Postgres for tests; tests work in a throwaway schema. Skipped when empty.
TEST_DATABASE_URL=
# Anthropic Console → workspace bakery-dashboard (monthly spend limit) → API Keys
ANTHROPIC_API_KEY=
# Error emails to the site maintainer (alerts.py). Leave ALERT_EMAIL empty to turn them off.
# Next stage: the maintainer's address + a Gmail app password (myaccount.google.com/apppasswords).
ALERT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
